# Copie para .env (local) ou cadastre em Vercel → Settings → Environment Variables.
# Nunca coloque valores reais neste arquivo: ele é versionado.

# --- Supabase (app) ---
# Públicas: podem ir para o navegador
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secretas: só no servidor (API / worker)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Login por código de e-mail (decisão 50; ver docs/login.md) ---
# Sem INC_AUTH_SECRET, em produção o app inteiro responde 503. Gere com: openssl rand -base64 48
INC_AUTH_SECRET=
# O "carteiro" que entrega o código por e-mail (workflow do Pipedream ou outro) e o segredo próprio dele
# (outro valor, nunca o INC_AUTH_SECRET). Sem AUTH_MAILER_URL, em desenvolvimento o código sai no log do servidor.
AUTH_MAILER_URL=
AUTH_MAILER_SECRET=
# Opcional: domínio aceito no login (padrão @meuinc.com.br)
INC_AUTH_DOMINIO=

# --- IA e transcrição ---
ANTHROPIC_API_KEY=
# Só se a chave não for de um workspace específico
ANTHROPIC_WORKSPACE_ID=
# Groq: revisão de texto dos POPs com IA (openai/gpt-oss-120b, reserva openai/gpt-oss-20b)
GROQ_API_KEY=
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_WEBHOOK_SECRET=
# Entrevista por voz com a IA (decisão 41): GPT-Live da OpenAI. Opcionais: voz (bossa ou tempo),
# modelo de voz e modelo da análise no fim (Claude)
OPENAI_API_KEY=
INCFLOW_VOZ_ENTREVISTA=
INCFLOW_MODELO_VOZ=
INCFLOW_MODELO_ANALISE=
# Modelo do Claude que responde às consultas da IA no meio da entrevista (padrão: claude-haiku-5-5)
INCFLOW_MODELO_CONSULTA=

# --- Notion ---
NOTION_TOKEN=

# --- MVP sem login ---
# Tenant padrão (o seed da migração cria este id)
FLUXI_TENANT_ID=00000000-0000-4000-8000-000000000001

# --- Supabase (configuração, só desenvolvimento) ---
SUPABASE_ACCESS_TOKEN=

# Observação: SUPABASE_ACCESS_TOKEN (token pessoal da Management API) é só para
# configurar o projeto no ambiente de desenvolvimento. Não é usado pela aplicação
# e não deve ser cadastrado na Vercel.

# Opcional: o endereço do app nos links dos e-mails (convites). Sem ele, usa a origem do próprio pedido.
# INC_APP_URL=https://incflow.vercel.app
